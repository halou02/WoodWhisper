    "master-4": {
      "category": "inherit/master",
      "sentences": [
        "陈培臣（1950年生），陈舜羌长子，第一批国家级非遗潮州木雕代表性传承人，潮州木雕界首位中国工艺美术大师",
        "13岁随父学艺，精通浮雕、通雕、圆雕",
        "1979年随父参与人民大会堂广东厅装修；2000年双面通雕《岭南佳果》被广东省政府选送人民大会堂；1998年用2.2米原木创作《龙虾蟹篓》，雕出18只龙虾、28只螃蟹共46只虾蟹，2001年获广东省首届工艺名家名作展金奖",
        "子陈树东、侄女陈嘉承袭衣钵，实现\"一门三代五件作品进人民大会堂\"的文化佳话"
      ],
      "files": [
        "assets/audio/inherit/master/master-4/s0.mp3",
        "assets/audio/inherit/master/master-4/s1.mp3",
        "assets/audio/inherit/master/master-4/s2.mp3",
        "assets/audio/inherit/master/master-4/s3.mp3"
      ]
    },
    "master-5": {
      "category": "inherit/master",
      "sentences": [
        "陈培希（1962年生），陈舜羌之子、陈培臣之弟，广东省高级工艺美术师、中国传统工艺美术大师",
        "1980年随父到金漆木雕厂习艺，作品尤以多层次龙虾蟹篓镂通雕刻著称",
        "代表作《篓中篓五篓一体虾蟹篓》利用2.1米原木五篓一体、篓中有篓，2011年送展期间受到国家领导人肯定；《三篓绝配》被中国工艺美术馆收藏；《松竹梅》《秋黄》《金鸡报喜》《双篓秋趣》等多次获国家级、省级金奖",
        "2017年创办陈培希木雕艺术馆任馆长",
        "女儿陈嘉为90后传承人"
      ],
      "files": [
        "assets/audio/inherit/master/master-5/s0.mp3",
        "assets/audio/inherit/master/master-5/s1.mp3",
        "assets/audio/inherit/master/master-5/s2.mp3",
        "assets/audio/inherit/master/master-5/s3.mp3",
        "assets/audio/inherit/master/master-5/s4.mp3"
      ]
